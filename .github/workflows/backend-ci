name: Backend CI

on:
	pull_request:
		branches:
			- main
		paths:
			- starter/backend/**
	workflow_dispatch:

defaults:
	run:
		working-directory: starter/backend

jobs:
	lint:
		runs-on: ubuntu-latest
		steps:
			- uses: actions/checkout@v4
			- uses: actions/setup-python@v5
				with:
					python-version: '3.10'
			- run: python -m pip install --upgrade pip pipenv
			- run: pipenv install
			- run: pipenv run lint

	test:
		runs-on: ubuntu-latest
		steps:
			- uses: actions/checkout@v4
			- uses: actions/setup-python@v5
				with:
					python-version: '3.10'
			- run: python -m pip install --upgrade pip pipenv
			- run: pipenv install
			- run: pipenv run test

	build:
		runs-on: ubuntu-latest
		needs:
			- lint
			- test
		steps:
			- uses: actions/checkout@v4
			- run: docker build --tag=mp-backend:latest .
